# =============================================================================
# TaskForge — Environment Variables
# =============================================================================
# Copy this file to `.env` for local development:
#     cp .env.example .env
# On Vercel, add each of these under: Project -> Settings -> Environment Variables
# Never commit the real `.env` file.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DATABASE (Neon Postgres)  [REQUIRED]
# -----------------------------------------------------------------------------
# Get these from https://console.neon.tech -> your project -> Connection Details.
#
# In the Neon Console: click "Connect" -> the "Connect to your database" modal
# has a "Connection pooling" toggle. You need the string in BOTH positions.
#
# DATABASE_URL       -> toggle ON.  Host contains "-pooler".
#                       Used by the app at runtime. PgBouncer is what keeps
#                       serverless functions under Neon's connection limit.
# DIRECT_URL         -> toggle OFF. No "-pooler" in the host.
#                       Used by `prisma migrate` ONLY — never at runtime.
#                       Migrations take advisory locks that do not survive
#                       transaction pooling.
#
# If you installed Neon via the Vercel Marketplace it provisions the direct
# string as DATABASE_URL_UNPOOLED. You do not need to rename it — prisma.config.ts
# accepts either name.
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/taskforge?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/taskforge?sslmode=require"


# -----------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js v5)  [REQUIRED]
# -----------------------------------------------------------------------------
# AUTH_SECRET  -> random 32+ byte secret used to sign/encrypt session JWTs.
#                 Generate one with:   openssl rand -base64 32
#                 (or:  npx auth secret)
# AUTH_URL     -> canonical URL of the deployment. Optional on Vercel (inferred),
#                 REQUIRED when self-hosting or running behind a proxy.
# AUTH_TRUST_HOST -> set to true when deploying anywhere other than Vercel.
#
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Session lifetime in seconds (default 8 hours). Optional.
SESSION_MAX_AGE="28800"


# -----------------------------------------------------------------------------
# 3. BOOTSTRAP ADMIN  [REQUIRED for first run — used by `npm run db:seed`]
# -----------------------------------------------------------------------------
# The seed script creates exactly one Admin account from these values.
# Change ADMIN_PASSWORD before seeding a production database, and rotate it
# from the UI after first login.
#
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@taskforge.local"
ADMIN_NAME="Platform Admin"
ADMIN_PASSWORD="ChangeMe!2024"

# bcrypt cost factor. 10 is the default; 12 is recommended for production.
BCRYPT_ROUNDS="12"


# -----------------------------------------------------------------------------
# 4. AI PROVIDER  [OPTIONAL — the app degrades gracefully without it]
# -----------------------------------------------------------------------------
# AI_PROVIDER: "groq" | "ollama" | "none"
#   groq   -> hosted inference, fast, needs GROQ_API_KEY. Recommended for Vercel.
#   ollama -> local/self-hosted inference, no API key, needs a reachable host.
#   none   -> disables the AI Copilot panel entirely.
#
AI_PROVIDER="groq"

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=""
# Groq retires models periodically. If you get "model not found", list the
# current ones:  curl -H "Authorization: Bearer $GROQ_API_KEY" \
#                     https://api.groq.com/openai/v1/models
# and pick a tool-calling capable one.
GROQ_MODEL="openai/gpt-oss-120b"

# --- Ollama (https://ollama.com) ---
# Local default is http://127.0.0.1:11434
# Pull the model first:  ollama pull llama3.1
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

# Hard ceiling on tokens per Copilot response. Optional.
AI_MAX_TOKENS="2048"

# --- "Fix with AI" engines [OPTIONAL] ---
# Independent of AI_PROVIDER above: the Copilot can chat on Groq while code
# fixes go to a stronger model. Every engine with a key is offered, in this
# order, and the first is the default: Anthropic, OpenAI, Groq (GROQ_API_KEY
# above). With none set, the button does not appear.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5"

# Voice input needs no configuration. Browsers with SpeechRecognition (Chrome,
# Edge, Safari) transcribe locally and for free. Others fall back to Whisper via
# the GROQ_API_KEY above, which has its own quota separate from chat.


# -----------------------------------------------------------------------------
# 5. SCHEDULED JOBS  [REQUIRED only if you use recurring tickets]
# -----------------------------------------------------------------------------
# Shared secret guarding /api/cron/recurring. Vercel Cron sends it as a Bearer
# token; see vercel.json for the schedule. Generate with: openssl rand -hex 32
#
CRON_SECRET="replace-me-with-openssl-rand-hex-32"


# -----------------------------------------------------------------------------
# 6. GITHUB  [OPTIONAL — nothing to set for the normal path]
# -----------------------------------------------------------------------------
# Connect GitHub from Workspace -> Integrations. TaskForge creates its own
# GitHub App through GitHub's manifest flow and stores the credentials in the
# database, sealed with a key derived from AUTH_SECRET. Rotating AUTH_SECRET
# therefore means reconnecting GitHub (one click).
#
# Set these only to pin an existing app from the environment instead. When all
# three are present they take precedence over the stored app.
# GITHUB_APP_ID=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=""
#
# Where GitHub should deliver webhooks when this deployment's own URL is not
# public — typically a tunnel in development:  ngrok http 3000
# It can also be changed later from the integrations page.
# GITHUB_WEBHOOK_URL="https://xxxx.ngrok-free.app/api/github/webhook"


# -----------------------------------------------------------------------------
# 7. EMAIL  [OPTIONAL — account, notification and manager emails, AI reports]
# -----------------------------------------------------------------------------
# Any SMTP server. For Gmail use an App Password (Google Account → Security →
# App passwords), never the account password. Without these nothing is emailed:
# new users get no welcome email (the admin passes the password on), the bell
# still shows notifications, managers get no Monday digest, and subscriptions on
# Workspace → AI are saved but not sent.
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="587"
# EMAIL_USER="you@gmail.com"
# EMAIL_PASS=""
# EMAIL_FROM="TaskForge <you@gmail.com>"


# -----------------------------------------------------------------------------
# 8. APPLICATION  [OPTIONAL]
# -----------------------------------------------------------------------------
# Public base URL, used for absolute links in the UI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TaskForge"

# --- Single sign-on (optional; each button appears only when its keys are set) ---
# Keycloak: the realm's issuer URL, and a confidential client whose redirect URI
# is <site>/api/auth/callback/keycloak. Only existing accounts can sign in.
# KEYCLOAK_ISSUER="https://auth.example.com/realms/yourrealm"
# KEYCLOAK_CLIENT_ID="taskforge"
# KEYCLOAK_CLIENT_SECRET=""
# KEYCLOAK_LABEL="Company login"
# Google (redirect URI <site>/api/auth/callback/google)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# Microsoft Entra ID (redirect URI <site>/api/auth/callback/microsoft-entra-id)
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# --- Email in (optional) ---
# Read over IMAP with the same account as EMAIL_USER/EMAIL_PASS. Defaults to the
# SMTP host with smtp. replaced by imap.
# IMAP_HOST="imap.gmail.com"
# IMAP_PORT="993"
