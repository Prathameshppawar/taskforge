// =============================================================================
// TaskForge — Prisma Schema
// AI-first internal project & ticket management platform
// =============================================================================
// Design principles:
//   1. Fully normalized. No JSON columns are used to model relational data.
//   2. Every foreign key declares an explicit referential action.
//   3. Workflow configuration (statuses / priorities / types / labels) is
//      PROJECT-SCOPED. The workspace-wide "admin configurable" defaults live in
//      ProjectTemplate, which is cloned into a project at creation time.
//      This avoids nullable-FK ambiguity and lets each project own its board.
//   4. Indexes cover every filter, sort and lookup path used by the UI.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// A member's capability inside one project, independent of their global role.
enum ProjectMemberRole {
  MANAGER
  MEMBER
  VIEWER
}

/// Semantic bucket for a status. Drives progress rollup, dashboards and the
/// "is this ticket finished?" question without hardcoding status names.
enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}

enum ResourceType {
  GITHUB
  SHAREPOINT
  FIGMA
  BUILD
  DOCUMENTATION
  API_SPEC
  OTHER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ActivityEntity {
  PROJECT
  TICKET
  COMMENT
  USER
  LABEL
  MEMBER
  RESOURCE
  STATUS
  PRIORITY
  TICKET_TYPE
  TEMPLATE
  RECURRING_TICKET
  ROLE
  TEAM
  INTEGRATION
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  RESTORED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  LABEL_ADDED
  LABEL_REMOVED
  MEMBER_ADDED
  MEMBER_REMOVED
  COMMENTED
  COMMENT_EDITED
  COMMENT_DELETED
  RESOURCE_ADDED
  RESOURCE_REMOVED
  PARENT_CHANGED
  DUE_DATE_CHANGED
  ACTIVATED
  DEACTIVATED
  PASSWORD_RESET
  LOGGED_IN
  AI_GENERATED
}

/// How two tickets relate. BLOCKS is directional — the source blocks the
/// target — while RELATES_TO and DUPLICATES read the same from either end and
/// are therefore stored once, not twice.
enum TicketLinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

/// A sprint is timeboxed and one runs at a time; a milestone is a goal with a
/// date, and several can be open at once — the shape client work often takes.
/// The kinds of value a project's own ticket fields can hold.
enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  URL
  USER
}

enum CycleKind {
  SPRINT
  MILESTONE
}

enum CycleState {
  PLANNED
  ACTIVE
  CLOSED
}

/// What a ticket type *means*, independent of what a project calls it.
///
/// Type names are free text — one team says "Bug", another "Defect" — so
/// anything that has to behave differently for a bug fix than for a deployment
/// reads this instead of the name. Renaming a type never changes its kind.
enum TicketKind {
  TASK
  FEATURE
  ENHANCEMENT
  BUG
  PRODUCTION
  DEPLOYMENT
  RESEARCH
}

/// The three kinds of development artefact that can mention a ticket.
enum GitRefKind {
  BRANCH
  PULL_REQUEST
  COMMIT
}

/// Lifecycle of a branch or pull request as GitHub last reported it. Commits
/// have no lifecycle and leave it null.
enum GitRefState {
  OPEN
  DRAFT
  MERGED
  CLOSED
}

/// Rolled-up CI result for a pull request's head commit.
enum GitCheckState {
  PENDING
  SUCCESS
  FAILURE
}

/// What an AI run was asked to do.
enum AiFixMode {
  /// Write a change and open a pull request.
  FIX
  /// Read the code and post an implementation plan for approval. No commit.
  PLAN
  /// Push a fix for failing CI onto an existing pull request's branch.
  HEAL_CI
  /// Build the first version of a brand-new repository from the ticket.
  SCAFFOLD
}

/// Lifecycle of one "Fix with AI" attempt.
enum AiFixStatus {
  QUEUED
  RUNNING
  /// A pull request was opened.
  SUCCEEDED
  /// The model finished without changing anything.
  NO_CHANGES
  FAILED
}

/// What a model call was for, so usage can be reported by feature.
enum AiFeature {
  COPILOT
  AI_FIX
  CAPTURE
  FILTER
  WEEKLY_UPDATE
  PR_REVIEW
  RELEASE_NOTES
  TRIAGE
  POSTMORTEM
  PLANNING
}

/// What a budget caps: everything, one project, or one provider.
enum AiBudgetScope {
  WORKSPACE
  PROJECT
  PROVIDER
}

/// Reports someone can subscribe to, directly or through a team.
enum ReportKind {
  /// Monday morning: last week's AI spend by project, person and provider.
  AI_USAGE_WEEKLY
  /// The moment a budget crosses 80% and again at 100%.
  AI_BUDGET_ALERT
}

/// A deployment's state as its provider last reported it to GitHub.
enum DeploymentState {
  PENDING
  QUEUED
  IN_PROGRESS
  SUCCESS
  FAILURE
  ERROR
  INACTIVE
}

/// What an uptime monitor last saw.
enum MonitorState {
  UNKNOWN
  UP
  DOWN
}

enum NotificationType {
  MENTIONED
  ASSIGNED
  COMMENT_REPLY
  TICKET_BLOCKED
  /// A ticket's response or resolution target is 80% spent.
  SLA_AT_RISK
  /// A ticket's response or resolution target has passed.
  SLA_BREACHED
}

enum FilterField {
  CYCLE
  PROJECT
  ASSIGNEE
  REPORTER
  STATUS
  STATUS_CATEGORY
  PRIORITY
  TYPE
  LABEL
  PARENT
  DUE_DATE
  CREATED_AT
  UPDATED_AT
  SEARCH
}

enum FilterOperator {
  EQUALS
  NOT_EQUALS
  IN
  NOT_IN
  CONTAINS
  BEFORE
  AFTER
  BETWEEN
  IS_NULL
  IS_NOT_NULL
}

enum ViewType {
  TABLE
  KANBAN
  CALENDAR
  TIMELINE
}

// =============================================================================
// IDENTITY & ACCESS
// =============================================================================

/// A role an administrator can define. The three seeded roles are marked
/// `isSystem` and cannot be deleted or re-keyed, so an edit can never leave the
/// workspace with nobody able to administer it.
model Role {
  id          String  @id @default(cuid())
  /// Stable identifier. Free-form so administrators can add their own.
  key         String  @unique
  name        String
  description String?
  /// System roles cannot be deleted or re-keyed.
  isSystem    Boolean @default(false)

  /// Authority ranking, lower being more senior: Admin is 0. A user may only
  /// grant, edit or delete roles ranked strictly below their own, which is what
  /// stops a manager promoting themselves or a peer. Seeded with gaps so custom
  /// roles can be slotted between the built-in ones without renumbering.
  level Int @default(100)

  /// Colour token for the rim drawn around the avatar of everyone holding this
  /// role, so a project manager reads as one at a glance. Null draws no rim.
  color String?

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@map("roles")
}

/// One granted permission. The permission *catalogue* stays in TypeScript
/// (`core/domain/rbac.ts`) so code cannot reference a capability nothing
/// enforces; only the mapping from role to permission is data.
model RolePermission {
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@index([permission])
  @@map("role_permissions")
}

/// A group of people with one or more managers. Delegated administration is
/// scoped through teams: a team manager may act on their own team's members and
/// nobody else's.
model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  reportSubscriptions ReportSubscription[]
  members             TeamMember[]
  projects            ProjectTeam[]

  createdById String?
  createdBy   User?   @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

/// A team's access to a project.
///
/// Attaching a team is the intended way to staff a project: everyone in it gains
/// the given project role, and a change of team membership takes effect
/// everywhere at once. Direct ProjectMember rows still exist for exceptions —
/// a contractor on one project, or the owner — and the two are unioned, with the
/// strongest role winning.
model ProjectTeam {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role ProjectMemberRole @default(MEMBER)

  addedById String?
  addedBy   User?   @relation("ProjectTeamAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@id([projectId, teamId])
  @@index([teamId])
  @@map("project_teams")
}

model TeamMember {
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Managers may administer the other members of this team, bounded by the
  /// role level ceiling.
  isManager Boolean @default(false)

  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String           @unique
  name            String
  passwordHash    String
  /// Short colour token used for the generated avatar. Keeps the UI stable
  /// without storing uploads.
  avatarColor     String           @default("slate")
  /// When the profile photo last changed; null means none. Part of the image
  /// URL, so a new photo is a new URL and the old one can be cached for ever.
  avatarUpdatedAt DateTime?
  avatarImage     UserAvatarImage?
  jobTitle        String?

  /// Whether the notification chime plays for this person.
  ///
  /// Stored on the account rather than in the browser so that muting on a
  /// laptop also mutes on a phone. Defaults on: someone who has never opened
  /// the setting should still hear that work arrived.
  notificationSound  Boolean @default(true)
  /// Whether notifications (assigned, mentioned, replied to, blocked) are also
  /// emailed. Defaults on, like the chime; off in Settings → Notifications.
  emailNotifications Boolean @default(true)
  /// Whether a project manager receives the Monday digest and urgent-ticket
  /// alerts for the projects they manage.
  emailDigest        Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  isActive           Boolean @default(true)
  /// Forces a password change on next sign-in. Set by admin password resets.
  mustChangePassword Boolean @default(false)
  /// An AI agent account (TaskForge Coder, Planner…). It authors comments and
  /// appears in history under its own name, and can never sign in: `authorize`
  /// refuses it before a password is even compared.
  isAgent            Boolean @default(false)
  /// Bumped on deactivation / password reset to invalidate every issued JWT.
  sessionVersion     Int     @default(1)

  lastLoginAt   DateTime?
  deactivatedAt DateTime?

  /// Consecutive failed sign-ins. Reset on success.
  failedLoginAttempts Int       @default(0)
  /// Set once the threshold is crossed; sign-in is refused until it passes.
  lockedUntil         DateTime?

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  teamMemberships TeamMember[]
  watching        TicketWatcher[]
  createdLinks    TicketLink[]       @relation("TicketLinkCreatedBy")
  uploads         TicketAttachment[] @relation("AttachmentUploadedBy")
  attachedTeams   ProjectTeam[]      @relation("ProjectTeamAddedBy")
  createdTeams    Team[]             @relation("TeamCreatedBy")

  // --- reverse relations -----------------------------------------------------
  ownedProjects       Project[]             @relation("ProjectOwner")
  createdProjects     Project[]             @relation("ProjectCreatedBy")
  defaultForSettings  ProjectSettings[]     @relation("ProjectDefaultAssignee")
  memberships         ProjectMember[]       @relation("ProjectMemberUser")
  membershipsAdded    ProjectMember[]       @relation("ProjectMemberAddedBy")
  assignedTickets     Ticket[]              @relation("TicketAssignee")
  reportedTickets     Ticket[]              @relation("TicketReporter")
  createdTickets      Ticket[]              @relation("TicketCreatedBy")
  comments            Comment[]
  mentions            CommentMention[]
  activities          ActivityLog[]         @relation("ActivityActor")
  resources           TicketResource[]
  savedFilters        SavedFilter[]
  aiFixRuns           AiFixRun[]
  aiUsage             AiUsageEvent[]
  githubToken         GithubUserToken?
  reportSubscriptions ReportSubscription[]  @relation("ReportSubscriber")
  reportSubsCreated   ReportSubscription[]  @relation("ReportSubscriptionCreatedBy")
  sessions            UserSession[]
  accessTokens        AccessToken[]
  notifications       Notification[]        @relation("NotificationRecipient")
  notificationsCaused Notification[]        @relation("NotificationActor")
  createdTemplates    ProjectTemplate[]
  recurringTickets    RecurringTicket[]     @relation("RecurringCreatedBy")
  recurringAssignee   RecurringTicket[]     @relation("RecurringAssignee")
  checklistDone       TicketChecklistItem[] @relation("ChecklistDoneBy")
  cyclesCreated       Cycle[]               @relation("CycleCreatedBy")
  timeEntries         TimeEntry[]           @relation("TimeEntryUser")
  bulkOperations      BulkOperation[]       @relation("BulkOperationActor")
  inboundEmails       InboundEmail[]        @relation("InboundEmailSender")
  teamsAccounts       MsTeamsUser[]         @relation("MsTeamsAccount")
  documentsWritten    ProjectDocument[]     @relation("DocumentAuthor")
  checklistCreated    TicketChecklistItem[] @relation("ChecklistCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([name])
  @@map("users")
}

/// Personal access token for non-browser clients (the MCP server, scripts, CI).
///
/// Only the hash is stored — the plaintext is shown once at creation and is
/// unrecoverable afterwards, so a database leak does not yield usable tokens.
/// A token is strictly an alias for its user: it carries no permissions of its
/// own, so every request it makes is bounded by that user's role exactly as a
/// browser session would be.
model AccessToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human label, e.g. "Claude Desktop".
  name      String
  /// SHA-256 of the token. Never the token itself.
  tokenHash String @unique
  /// First 8 characters, shown in the UI so a token can be identified.
  prefix    String

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("access_tokens")
}

/// In-app notification.
///
/// Mentions and assignments were previously recorded and never surfaced — the
/// data existed, nobody was told. This is the delivery half.
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  /// Who caused it. Null for system events.
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Anchors a mention or reply to the exact comment.
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  /// Rendered at write time so the row reads correctly after a rename.
  title String
  body  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// Serves the unread badge and the inbox list in one index.
  @@index([userId, readAt, createdAt])
  @@index([ticketId])
  @@map("notifications")
}

/// Login audit trail. Sessions themselves are stateless JWTs (required by the
/// Credentials provider); these rows give the admin visibility and an explicit
/// revoke action, enforced through User.sessionVersion.
/// A profile photo. Kept apart from User so that loading a user never loads
/// the bytes; resized in the browser to a small square before upload.
model UserAvatarImage {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  content     Bytes
  updatedAt   DateTime @updatedAt

  @@map("user_avatar_images")
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, createdAt])
  @@map("user_sessions")
}

// =============================================================================
// PROJECT TEMPLATES
// Workspace-level, admin-configurable blueprints. Cloned into a project on
// "Create from Template".
// =============================================================================

model ProjectTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  icon        String  @default("layout-template")
  color       String  @default("indigo")
  isActive    Boolean @default(true)
  /// The single template applied when a project is created without choosing one.
  isDefault   Boolean @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  statuses   TemplateStatus[]
  priorities TemplatePriority[]
  types      TemplateTicketType[]
  labels     TemplateLabel[]
  tickets    TemplateTicket[]
  projects   Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("project_templates")
}

model TemplateStatus {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name      String
  category  StatusCategory
  color     String         @default("slate")
  position  Int
  /// Status applied to newly created tickets.
  isInitial Boolean        @default(false)

  @@unique([templateId, name])
  @@unique([templateId, position])
  @@index([templateId])
  @@map("template_statuses")
}

model TemplatePriority {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name      String
  color     String  @default("slate")
  /// Higher = more urgent. Drives sorting.
  level     Int
  isDefault Boolean @default(false)

  @@unique([templateId, name])
  @@unique([templateId, level])
  @@index([templateId])
  @@map("template_priorities")
}

model TemplateTicketType {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name      String
  color     String     @default("slate")
  icon      String     @default("circle-dot")
  position  Int
  isDefault Boolean    @default(false)
  kind      TicketKind @default(TASK)

  descriptionTemplate String?
  checklistTemplate   String[] @default([])

  @@unique([templateId, name])
  @@index([templateId])
  @@map("template_ticket_types")
}

model TemplateLabel {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name        String
  color       String  @default("slate")
  description String?

  @@unique([templateId, name])
  @@index([templateId])
  @@map("template_labels")
}

/// Default ticket scaffold. Self-referencing so a template can ship a parent
/// feature with its child tasks already laid out.
model TemplateTicket {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title        String
  description  String?
  /// Resolved by NAME against the cloned project config at creation time.
  typeName     String?
  priorityName String?
  labelNames   TemplateTicketLabel[]

  parentId String?
  parent   TemplateTicket?  @relation("TemplateTicketTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TemplateTicket[] @relation("TemplateTicketTree")

  position Int @default(0)

  @@index([templateId])
  @@index([parentId])
  @@map("template_tickets")
}

model TemplateTicketLabel {
  templateTicketId String
  templateTicket   TemplateTicket @relation(fields: [templateTicketId], references: [id], onDelete: Cascade)
  labelName        String

  @@id([templateTicketId, labelName])
  @@map("template_ticket_labels")
}

// =============================================================================
// PROJECTS
// =============================================================================

model Project {
  id          String        @id @default(cuid())
  name        String
  /// Short uppercase key, also used as the ticket prefix (e.g. "AUTH" -> AUTH-14).
  code        String        @unique
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  templateId String?
  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  settings         ProjectSettings?
  members          ProjectMember[]
  teams            ProjectTeam[]
  labels           Label[]
  statuses         Status[]
  priorities       Priority[]
  ticketTypes      TicketType[]
  tickets          Ticket[]
  cycles           Cycle[]
  customFields     CustomField[]
  teamsChannels    MsTeamsConversation[]
  memoryChunks     MemoryChunk[]
  documents        ProjectDocument[]
  webhooks         OutboundWebhook[]
  activities       ActivityLog[]
  recurringTickets RecurringTicket[]
  savedFilters     SavedFilter[]
  repos            ProjectRepo[]
  aiUsage          AiUsageEvent[]
  aiBudgets        AiBudget[]
  monitors         Monitor[]
  errorGroups      ErrorGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([isArchived])
  @@index([code])
  @@map("projects")
}

/// One-to-one project configuration. Split from Project so the hot path
/// (listing projects) never loads settings it does not need.
model ProjectSettings {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Monotonic counter backing per-project ticket numbering (PROJ-1, PROJ-2...).
  nextTicketNumber Int     @default(1)
  color            String  @default("indigo")
  icon             String  @default("folder-kanban")
  /// Optional logo, referenced by URL. Consistent with the platform storing
  /// links rather than uploads; falls back to the colour swatch when unset.
  logoUrl          String?

  /// Roll a parent's status up automatically from its children's progress.
  /// The view opening the project lands on: one of LANDING_VIEWS in
  /// src/features/projects/views.ts. Insights by default.
  defaultView         String   @default("insights")
  autoStatusRollup    Boolean  @default(true)
  /// Allow creating child tickets under a parent.
  allowSubtasks       Boolean  @default(true)
  /// Reject ticket creation without a due date.
  requireDueDate      Boolean  @default(false)
  /// Only members of the project may view it.
  isPrivate           Boolean  @default(false)
  /// Let linked GitHub activity move tickets forward: a pull request opened
  /// moves one to Review, merged moves it to Done. Never moves one backward.
  githubAutomation    Boolean  @default(true)
  /// Let "Fix with AI" create and edit GitHub Actions workflows. Off by
  /// default: a workflow runs as soon as its pull request opens, so this is a
  /// deliberate per-project choice, and every workflow written is checked by
  /// `checkWorkflow` before it is committed.
  aiWorkflows         Boolean  @default(false)
  /// When an AI-authored pull request's CI fails, let the Coder push a fix to
  /// it — at most twice per pull request, so a problem it cannot solve does
  /// not become an endless, billable loop.
  aiAutoHeal          Boolean  @default(false)
  /// SHA-256 of the secret in this project's error-ingest URL. Only the hash is
  /// kept; the URL is shown once, when it is generated.
  errorIngestHash     String?  @unique
  /// AI pull requests open as drafts when the repository has CI, and are
  /// marked ready for review only once every check has passed.
  aiDraftUntilGreen   Boolean  @default(false)
  /// Merge an AI pull request without a person, when every condition holds:
  /// see `evaluateAutoMerge`. Off by default, and deliberately narrow.
  aiAutoMerge         Boolean  @default(false)
  /// Largest change auto-merge will accept, in added plus deleted lines.
  autoMergeMaxLines   Int      @default(40)
  /// Ticket kinds auto-merge may apply to, comma-separated.
  autoMergeKinds      String   @default("TASK,ENHANCEMENT")
  /// A ticket in progress, review or blocked for longer than this is flagged
  /// as stuck on the board. Null turns the flag off.
  stuckAfterDays      Int?     @default(5)
  /// Ticket kinds the priorities' response and resolution targets apply to,
  /// comma-separated.
  slaKinds            String   @default("PRODUCTION,BUG")
  /// What an hour of this project's billable time is charged at, for the
  /// client report. Null shows hours only.
  hourlyRate          Decimal? @db.Decimal(10, 2)
  /// ISO 4217 code the rate is in.
  currency            String   @default("USD")
  /// Whether email to this project's address (mailbox+code@) becomes tickets.
  emailIntake         Boolean  @default(false)
  /// Index finished tickets and the repositories' docs for search and the
  /// agents. Computed in-process, so it costs nothing but database space.
  memoryEnabled       Boolean  @default(true)
  /// Regenerate the project handbook every Monday.
  handbookAutoRefresh Boolean  @default(false)
  /// Let TaskForge Triage fill in what a new ticket left at its defaults.
  triageAgent         Boolean  @default(false)
  /// Email the managers (and post to linked Teams channels) a morning summary.
  dailyDigest         Boolean  @default(false)
  /// Refresh the board and table when someone else changes a ticket. Polls
  /// lightly while the tab is visible, so it is off unless asked for.
  liveUpdates         Boolean  @default(false)

  defaultAssigneeId String?
  defaultAssignee   User?   @relation("ProjectDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_settings")
}

/// A relationship between two tickets.
///
/// Stored once per pair and direction. The reverse reading ("is blocked by") is
/// derived when displaying rather than written as a second row, so a link can
/// never be half-deleted and the two directions cannot disagree.
model TicketLink {
  id       String         @id @default(cuid())
  sourceId String
  source   Ticket         @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   Ticket         @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type     TicketLinkType

  createdById String?
  createdBy   User?    @relation("TicketLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([targetId])
  @@map("ticket_links")
}

/// Someone following a ticket without being assigned to it.
model TicketWatcher {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([ticketId, userId])
  @@index([userId])
  @@map("ticket_watchers")
}

/// File metadata. The bytes live in TicketAttachmentData.
model TicketAttachment {
  id          String @id @default(cuid())
  ticketId    String
  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  /// Bytes, recorded here so a listing never has to touch the blob.
  size        Int

  data TicketAttachmentData?

  uploadedById String?
  uploadedBy   User?    @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

/// The bytes, deliberately in their own table.
///
/// Prisma selects every scalar column unless told otherwise, so keeping the
/// blob beside the filename would mean any forgotten `select` quietly reads
/// megabytes to render a list of names. A separate table makes that mistake
/// impossible rather than merely discouraged.
model TicketAttachmentData {
  attachmentId String           @id
  attachment   TicketAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  content      Bytes

  @@map("ticket_attachment_data")
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  role ProjectMemberRole @default(MEMBER)

  addedById String?
  addedBy   User?   @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

// =============================================================================
// PROJECT-SCOPED WORKFLOW CONFIGURATION
// =============================================================================

model Status {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  category     StatusCategory
  color        String         @default("slate")
  position     Int
  isInitial    Boolean        @default(false)
  /// Most tickets this column should hold at once; null means no limit. A
  /// soft limit: the board shows it and warns, and never refuses a move.
  wipLimit     Int?
  /// What must be true before a person moves a ticket into this status:
  /// ASSIGNEE, ESTIMATE, CRITERIA, PULL_REQUEST, MERGED_PR, or FIELD:<id>.
  /// See `core/domain/transitions.ts`. Automation moves only on evidence and
  /// is not held to these.
  requirements String[]       @default([])

  tickets          Ticket[]
  recurringTickets RecurringTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, position])
  @@index([projectId, category])
  @@map("statuses")
}

model Priority {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name               String
  color              String  @default("slate")
  level              Int
  isDefault          Boolean @default(false)
  /// Service targets for tickets of the kinds in ProjectSettings.slaKinds.
  /// Null means no target. The resolve clock pauses while a ticket is Blocked.
  respondWithinHours Int?
  resolveWithinHours Int?

  tickets          Ticket[]
  recurringTickets RecurringTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, level])
  @@index([projectId, level])
  @@map("priorities")
}

model TicketType {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  color     String     @default("slate")
  icon      String     @default("circle-dot")
  position  Int        @default(0)
  isDefault Boolean    @default(false)
  /// Semantic category, see TicketKind. Drives behaviour; the name is display.
  kind      TicketKind @default(TASK)

  /// Markdown a new ticket of this type starts with ("Steps to reproduce…").
  descriptionTemplate String?
  /// Acceptance criteria a new ticket of this type starts with, one per entry.
  checklistTemplate   String[] @default([])

  tickets          Ticket[]
  recurringTickets RecurringTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("ticket_types")
}

model Label {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  color       String  @default("slate")
  description String?

  tickets          TicketLabel[]
  recurringTickets RecurringTicketLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

// =============================================================================
// TICKETS
// Hierarchy: Project -> Parent Ticket (feature) -> Child Ticket (task).
// Depth is capped at 2 levels; the rule is enforced in the domain layer.
// =============================================================================

model Ticket {
  id String @id @default(cuid())

  /// Per-project sequential number, allocated from ProjectSettings.
  number Int
  /// Denormalized human key ("AUTH-14"). Unique platform-wide, indexed for the
  /// command palette and AI lookups. Derived from project.code + number.
  key    String @unique

  title       String
  description String?
  /// Free-form operator notes, kept separate from the description.
  remarks     String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statusId String
  status   Status @relation(fields: [statusId], references: [id], onDelete: Restrict)

  priorityId String
  priority   Priority @relation(fields: [priorityId], references: [id], onDelete: Restrict)

  typeId String
  type   TicketType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId String?
  reporter   User?   @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Ticket?  @relation("TicketTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Ticket[] @relation("TicketTree")

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  estimateHours Decimal? @db.Decimal(6, 2)
  storyPoints   Int?

  /// Sparse float ordering for drag-and-drop within a Kanban column.
  position Float @default(0)

  /// Weighted tsvector over title/description/remarks, generated by Postgres.
  /// Declared Unsupported because Prisma cannot express a STORED generated
  /// column; it is created and indexed in the migration.
  /// Sentence embedding of title + description, 384 dimensions, L2-normalised.
  /// Written and read only in raw SQL — Prisma has no vector type — exactly as
  /// `searchVector` is. `real[]` rather than `double precision[]` halves the
  /// storage for accuracy nobody can perceive in a similarity ranking.
  embedding     Unsupported("real[]")?
  /// md5 of the text that produced `embedding`, so a sweep can find rows whose
  /// source has changed without every write path having to remember to
  /// invalidate them.
  embeddingHash String?

  searchVector Unsupported("tsvector")?

  /// When the status last changed. Maintained by a database trigger, like
  /// the history rows in TicketStatusChange, so no write path can forget it.
  statusChangedAt DateTime  @default(now())
  /// The first sign someone other than the reporter picked this up: a
  /// comment by another person, or a move out of Backlog/To Do. Also kept by
  /// triggers. Stops the response clock.
  firstResponseAt DateTime?

  isArchived Boolean @default(false)

  /// The sprint or milestone this ticket is planned into, if any.
  cycleId     String?
  cycle       Cycle?  @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  /// Order in the backlog, lowest first; null sorts after every ranked ticket.
  backlogRank Float?
  /// Where an imported ticket came from — "jira:ABC-12", "trello:#4" — so a
  /// second run of the same import skips what the first already brought in.
  externalRef String?

  /// Set when the ticket was materialized by a RecurringTicket schedule.
  recurringTicketId String?
  recurringTicket   RecurringTicket? @relation(fields: [recurringTicketId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  labels        TicketLabel[]
  resources     TicketResource[]
  comments      Comment[]
  linksOut      TicketLink[]          @relation("LinkSource")
  linksIn       TicketLink[]          @relation("LinkTarget")
  watchers      TicketWatcher[]
  attachments   TicketAttachment[]
  activities    ActivityLog[]
  notifications Notification[]
  gitRefs       TicketGitRef[]
  deployments   TicketDeployment[]
  errorGroups   ErrorGroup[]
  aiFixRuns     AiFixRun[]
  checklist     TicketChecklistItem[]
  statusHistory TicketStatusChange[]
  cycleHistory  TicketCycleChange[]
  timeEntries   TimeEntry[]
  fieldValues   TicketFieldValue[]
  inboundEmails InboundEmail[]
  triageRuns    TriageRun[]
  slaAlerts     TicketSlaAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@unique([projectId, externalRef])
  @@index([projectId, statusId])
  @@index([projectId, isArchived])
  @@index([assigneeId, statusId])
  @@index([parentId])
  @@index([dueDate])
  @@index([priorityId])
  @@index([typeId])
  @@index([reporterId])
  @@index([createdAt])
  @@index([projectId, statusId, position])
  @@index([recurringTicketId])
  @@index([cycleId])
  @@map("tickets")
}

/// An acceptance criterion: one thing that must be true for the ticket to be
/// done. People tick them; the Coder works against them and the Reviewer checks
/// a diff against each one.
model TicketChecklistItem {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  text     String
  isDone   Boolean @default(false)
  /// Sparse float ordering, like a Kanban card's.
  position Float   @default(0)

  doneAt      DateTime?
  doneById    String?
  doneBy      User?     @relation("ChecklistDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("ChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, position])
  @@map("ticket_checklist_items")
}

/// One status change: every one, from every write path.
///
/// Written only by a Postgres trigger on `tickets`, never by application code —
/// status changes happen in a dozen places (the board, bulk edit, GitHub, the
/// Copilot, rollup, the portal), and a history that depends on each of them
/// remembering is a history with holes. The categories are snapshots, so a
/// status later moved to another category does not rewrite the past.
model TicketStatusChange {
  id       String @id @default(dbgenerated("gen_random_uuid()::text"))
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Plain ids, not relations: deleting a status must not touch its history.
  fromStatusId String?
  toStatusId   String?
  fromCategory StatusCategory?
  toCategory   StatusCategory
  changedAt    DateTime        @default(now())

  @@index([ticketId, changedAt])
  @@index([changedAt])
  @@map("ticket_status_changes")
}

/// A sprint or milestone: a set of tickets with a goal and, usually, dates.
model Cycle {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  kind      CycleKind  @default(SPRINT)
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  state     CycleState @default(PLANNED)
  /// Story points the team expects to finish — or tickets, where nothing in
  /// the project is pointed. Used to fill a cycle, never to refuse a ticket.
  capacity  Int?

  startedAt DateTime?
  closedAt  DateTime?
  /// Written when it closes: what was finished and what carried over.
  summary   Json?

  createdById String?
  createdBy   User?   @relation("CycleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, state])
  @@map("cycles")
}

/// A ticket moving into or out of a cycle. Written by a trigger, like status
/// history, so a burn-up can show scope added mid-sprint rather than drawing
/// today's scope as if it had always been there.
model TicketCycleChange {
  id       String @id @default(dbgenerated("gen_random_uuid()::text"))
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromCycleId String?
  toCycleId   String?
  changedAt   DateTime @default(now())

  @@index([ticketId, changedAt])
  @@index([toCycleId])
  @@index([fromCycleId])
  @@map("ticket_cycle_changes")
}

/// A field a project adds to its tickets: environment, customer, browser.
model CustomField {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  type        CustomFieldType
  description String?
  /// The choices, for SELECT and MULTI_SELECT.
  options     String[]        @default([])
  /// Asked for when a ticket is created in the dialog.
  required    Boolean         @default(false)
  position    Int             @default(0)

  values TicketFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("custom_fields")
}

/// One ticket's value for one custom field, normalised to text by
/// `normaliseFieldValue`: numbers as numbers, dates as YYYY-MM-DD, a multi-
/// select as a JSON array, a checkbox as "true".
model TicketFieldValue {
  ticketId String
  ticket   Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fieldId  String
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value    String

  updatedAt DateTime @updatedAt

  @@id([ticketId, fieldId])
  @@index([fieldId, value])
  @@map("ticket_field_values")
}

/// Every email the mailbox read, and what became of it. The unique Message-ID
/// is what makes polling idempotent: a message read twice is handled once.
model InboundEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique
  fromAddress String
  subject     String
  receivedAt  DateTime
  /// CREATED, COMMENTED, REJECTED, IGNORED or FAILED.
  outcome     String
  reason      String?

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  userId   String?
  user     User?   @relation("InboundEmailSender", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("inbound_emails")
}

/// A Microsoft Teams conversation the bot is part of: a personal chat, a group
/// chat, or a channel thread. Keyed by the Bot Framework conversation id.
model MsTeamsConversation {
  id         String  @id
  tenantId   String?
  /// Where replies are posted; each conversation has its own.
  serviceUrl String
  /// personal, groupChat or channel.
  kind       String
  name       String?

  /// The project tickets from here are filed in. A channel linked to a project
  /// also hears about the project's new tickets.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notify    Boolean  @default(true)

  /// The ticket being shaped: { title, description, type, priority, criteria }.
  draft             Json?
  /// Who has written while this draft was being shaped.
  draftParticipants String[] @default([])

  messages MsTeamsMessage[]

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@map("msteams_conversations")
}

/// What was said, kept short-term so the bot can follow a brainstorm.
model MsTeamsMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MsTeamsConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user or bot.
  role           String
  authorName     String?
  userId         String?
  text           String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("msteams_messages")
}

/// A Teams account (Entra object id) and the TaskForge account it is, matched
/// by email the first time that person writes.
model MsTeamsUser {
  aadObjectId String   @id
  tenantId    String?
  email       String?
  userId      String?
  user        User?    @relation("MsTeamsAccount", fields: [userId], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("msteams_users")
}

/// A piece of project knowledge, embedded for search: a finished ticket and
/// how it was resolved, a section of a repository's docs, the handbook.
/// Capped per project, because the free database is small.
model MemoryChunk {
  id         String                 @id @default(cuid())
  projectId  String
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// TICKET, REPO_DOC or HANDBOOK.
  sourceType String
  sourceId   String
  chunkIndex Int                    @default(0)
  title      String
  url        String?
  text       String
  /// md5 of `text`, so an unchanged source is not embedded again.
  hash       String
  /// 384-dimension sentence embedding, like tickets'. Raw SQL only.
  embedding  Unsupported("real[]")?

  updatedAt DateTime @updatedAt

  @@unique([projectId, sourceType, sourceId, chunkIndex])
  @@index([projectId])
  @@map("memory_chunks")
}

/// A generated or edited project document, every version kept. The handbook
/// is the first kind: what a new member reads on their first day.
model ProjectDocument {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String  @default("HANDBOOK")
  version   Int
  title     String
  body      String
  /// AI, FACTS (assembled without a model) or EDIT (a person's revision).
  source    String
  engine    String?
  authorId  String?
  author    User?   @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([projectId, kind, version])
  @@map("project_documents")
}

/// The latest version of a document someone has opened.
model ProjectDocumentRead {
  userId    String
  projectId String
  kind      String
  version   Int
  readAt    DateTime @default(now())

  @@id([userId, projectId, kind])
  @@map("project_document_reads")
}

/// What TaskForge Triage changed on a ticket, so it can be undone.
model TriageRun {
  id       String    @id @default(cuid())
  ticketId String
  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// { field: { from, to } } for each field it set.
  changes  Json
  summary  String
  undoneAt DateTime?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("triage_runs")
}

/// An HTTP endpoint told about ticket events, signed with HMAC-SHA256 like
/// GitHub's webhooks. Deliveries go through the job queue, with retries.
model OutboundWebhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  secretEnc   String
  /// ticket.created, ticket.status_changed, ticket.completed, comment.created
  events      String[]
  /// Null means every project.
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  active      Boolean  @default(true)
  createdById String?

  lastStatus      Int?
  lastError       String?
  lastDeliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("outbound_webhooks")
}

/// How far the webhook outbox has read the histories. One row.
model OutboxCursor {
  id              Int      @id @default(1)
  statusChangesAt DateTime @default(now())
  commentsAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("outbox_cursor")
}

/// Background work, queued in Postgres: webhook deliveries, triage, indexing.
///
/// A free-tier stand-in for a job service. Jobs are claimed with
/// `FOR UPDATE SKIP LOCKED`, so two drains never take the same one; a failed
/// job is retried with backoff; a job left RUNNING by a function that died is
/// taken back after ten minutes. Drained right after the request that queued
/// it, and by the five-minute cron for anything left over.
model Job {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  /// PENDING, RUNNING, DONE or FAILED.
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  /// Queuing the same key twice while the first is pending is a no-op.
  dedupeKey   String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([kind, status])
  @@map("jobs")
}

/// Email in, for the whole workspace. One row.
model InboundEmailSetting {
  id              Int       @id @default(1)
  enabled         Boolean   @default(false)
  /// Let the Copilot's engine turn an email into a structured ticket: type,
  /// priority and acceptance criteria. Off, the email is filed as written.
  structureWithAi Boolean   @default(true)
  lastPolledAt    DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt

  @@map("inbound_email_settings")
}

/// A bulk edit, remembered so it can be undone: what each ticket looked like
/// before, and its `updatedAt` straight after, so an undo can tell which
/// tickets someone has touched since and leave those alone.
model BulkOperation {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("BulkOperationActor", fields: [actorId], references: [id], onDelete: SetNull)

  summary  String
  /// [{ ticketId, key, afterUpdatedAt, before: { statusId, priorityId, assigneeId, completedAt, labelIds } }]
  changes  Json
  undoneAt DateTime?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@map("bulk_operations")
}

/// Time someone spent on a ticket: a running timer (no `endedAt`), a stopped
/// one, or an entry typed in afterwards. Minutes are what counts; the start
/// and end are kept so a day's timesheet can be read back.
model TimeEntry {
  id       String  @id @default(cuid())
  ticketId String
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Nullable so the hours survive if an account is ever removed: billing
  /// records outlive the people who made them.
  userId   String?
  user     User?   @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: SetNull)

  startedAt DateTime
  endedAt   DateTime?
  /// Null only while a timer runs.
  minutes   Int?
  note      String?
  billable  Boolean   @default(true)
  /// TIMER or MANUAL.
  source    String    @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("time_entries")
}

/// An SLA alert already sent, so each is sent once: "respond:warn",
/// "respond:breach", "resolve:warn", "resolve:breach".
model TicketSlaAlert {
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind     String
  sentAt   DateTime @default(now())

  @@id([ticketId, kind])
  @@map("ticket_sla_alerts")
}

/// Explicit join model (rather than an implicit m-n) so the pairing carries its
/// own timestamp and can be audited.
model TicketLabel {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  labelId  String
  label    Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([ticketId, labelId])
  @@index([labelId])
  @@map("ticket_labels")
}

/// References to external artefacts. The platform deliberately stores no file
/// uploads — only links.
model TicketResource {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  name  String
  type  ResourceType @default(OTHER)
  url   String
  notes String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([type])
  @@map("ticket_resources")
}

// =============================================================================
// COLLABORATION
// =============================================================================

model Comment {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String @db.Text

  /// Threading: a reply points at the comment it answers.
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  /// Soft delete keeps the thread structure intact.
  deletedAt DateTime?

  mentions      CommentMention[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model CommentMention {
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

// =============================================================================
// AUDIT
// A single append-only timeline across every entity. Field-level diffs are
// stored as columns rather than JSON so they stay queryable.
// =============================================================================

model ActivityLog {
  id String @id @default(cuid())

  action      ActivityAction
  entityType  ActivityEntity
  /// Id of the changed entity. Not an FK — the row must survive its deletion.
  entityId    String
  /// Human label captured at write time so the log reads correctly even after
  /// the referenced record is renamed or removed.
  entityLabel String?

  /// Optional scoping FKs, set when the change belongs to a project / ticket so
  /// the timeline can be filtered cheaply.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Field-level diff for UPDATED-style actions.
  field    String?
  oldValue String?
  newValue String?
  /// Pre-rendered one-line summary, e.g. "moved AUTH-14 to In Review".
  summary  String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// AUTOMATION
// =============================================================================

model RecurringTicket {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  title       String
  description String?

  statusId String
  status   Status @relation(fields: [statusId], references: [id], onDelete: Restrict)

  priorityId String
  priority   Priority @relation(fields: [priorityId], references: [id], onDelete: Restrict)

  typeId String
  type   TicketType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("RecurringAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  frequency  RecurrenceFrequency
  /// Repeat every N periods of `frequency` (e.g. frequency=WEEKLY, interval=2).
  interval   Int                 @default(1)
  /// 0 = Sunday .. 6 = Saturday. Used by WEEKLY / BIWEEKLY.
  dayOfWeek  Int?
  /// 1..31, clamped to the month's length. Used by MONTHLY / QUARTERLY / YEARLY.
  dayOfMonth Int?
  /// Days added to the generated ticket's creation date to set its due date.
  dueInDays  Int?

  startDate DateTime
  endDate   DateTime?

  nextRunAt DateTime
  lastRunAt DateTime?
  runCount  Int       @default(0)
  isActive  Boolean   @default(true)

  createdById String?
  createdBy   User?   @relation("RecurringCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  labels           RecurringTicketLabel[]
  generatedTickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isActive, nextRunAt])
  @@map("recurring_tickets")
}

model RecurringTicketLabel {
  recurringTicketId String
  recurringTicket   RecurringTicket @relation(fields: [recurringTicketId], references: [id], onDelete: Cascade)
  labelId           String
  label             Label           @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([recurringTicketId, labelId])
  @@index([labelId])
  @@map("recurring_ticket_labels")
}

// =============================================================================
// SAVED FILTERS
// Criteria are normalized into rows rather than stored as a JSON blob, so a
// saved filter can itself be queried ("which filters reference this label?").
// =============================================================================

model SavedFilter {
  id   String @id @default(cuid())
  name String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Null = the filter spans every project the viewer can access.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Visible to every user who can see the underlying tickets.
  isShared Boolean  @default(false)
  isPinned Boolean  @default(false)
  viewType ViewType @default(TABLE)

  sortBy  String @default("updatedAt")
  sortDir String @default("desc")

  criteria SavedFilterCriterion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([projectId])
  @@map("saved_filters")
}

model SavedFilterCriterion {
  id            String      @id @default(cuid())
  savedFilterId String
  savedFilter   SavedFilter @relation(fields: [savedFilterId], references: [id], onDelete: Cascade)

  field    FilterField
  operator FilterOperator
  /// Scalar operand. Multi-value operators (IN / BETWEEN) emit one row per value.
  value    String

  position Int @default(0)

  @@index([savedFilterId])
  @@map("saved_filter_criteria")
}

// =============================================================================
// GITHUB INTEGRATION
// =============================================================================

/// The workspace's own GitHub App. There is exactly one, so the primary key is
/// pinned to 1.
///
/// Created through GitHub's manifest flow, which hands the credentials back to
/// us rather than to a person — nobody ever copies a private key out of a
/// browser. The secrets are sealed with AES-256-GCM before they are written;
/// see `src/infrastructure/github/secrets.ts`. Environment variables, when set,
/// take precedence over this row.
model GithubApp {
  id               Int    @id @default(1)
  appId            Int    @unique
  slug             String
  name             String
  ownerLogin       String
  htmlUrl          String
  clientId         String
  /// Sealed. Kept for a later user-to-server flow; unused today.
  clientSecretEnc  String
  privateKeyEnc    String
  webhookSecretEnc String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_apps")
}

/// One install of the app on a GitHub account — a personal account or an
/// organisation. Each carries its own repository grant.
model GithubInstallation {
  id                  String    @id @default(cuid())
  /// GitHub's id. BigInt because GitHub's ids have already passed 2^31 in
  /// places, and an install id is not a number anything should overflow on.
  installationId      BigInt    @unique
  accountLogin        String
  /// "User" or "Organization", as GitHub reports it.
  accountType         String
  avatarUrl           String?
  /// "all" or "selected" — whether new repositories are granted automatically.
  repositorySelection String
  suspendedAt         DateTime?
  /// Set when the app is uninstalled from this account. The row is kept, with
  /// its repositories marked inaccessible, so the tickets that point at them
  /// keep their history; reinstalling clears it.
  removedAt           DateTime?

  repos GithubRepo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_installations")
}

/// A repository the app can see, mirrored so a picker does not need a round
/// trip to GitHub. Rows are never deleted when access is withdrawn — they are
/// marked inaccessible — so the ticket history that points at them survives.
model GithubRepo {
  id             String             @id @default(cuid())
  githubId       BigInt             @unique
  installationId String
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  /// "owner/name", the form every GitHub API path uses.
  fullName      String
  name          String
  ownerLogin    String
  isPrivate     Boolean @default(false)
  defaultBranch String  @default("main")
  htmlUrl       String
  description   String?
  /// False once the install no longer grants this repository.
  isAccessible  Boolean @default(true)

  projects    ProjectRepo[]
  refs        TicketGitRef[]
  aiFixRuns   AiFixRun[]
  deployments Deployment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installationId])
  @@index([fullName])
  @@map("github_repos")
}

/// Which repositories a project's work lands in. Many-to-many: a project can
/// span an app, an API and a CMS, and a shared library can serve several
/// projects.
model ProjectRepo {
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoId    String
  repo      GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  /// What this repository is to the project — "Tablet app", "API". Optional.
  role String?

  createdAt DateTime @default(now())

  @@id([projectId, repoId])
  @@index([repoId])
  @@map("project_repos")
}

/// A branch, pull request or commit that mentions a ticket by key.
///
/// Written by the webhook and by reconciliation, both through the same upsert,
/// so a redelivered event or a sweep that overlaps a webhook changes nothing.
model TicketGitRef {
  id       String     @id @default(cuid())
  ticketId String
  ticket   Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  kind       GitRefKind
  /// Branch name, pull request number, or commit sha — unique within a kind.
  externalId String

  title           String
  url             String
  state           GitRefState?
  checkState      GitCheckState?
  authorLogin     String?
  /// For pull requests: the head commit, which is what CI reports against.
  headSha         String?
  headBranch      String?
  mergedAt        DateTime?
  /// The commit a merge produced on the base branch — what a production
  /// deployment of that branch will actually contain.
  mergeCommitSha  String?
  /// The Reviewer's last verdict on this pull request: looks_good,
  /// minor_issues or needs_work. Auto-merge requires looks_good.
  aiReviewVerdict String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId, repoId, kind, externalId])
  @@index([repoId, kind, externalId])
  @@index([repoId, headSha])
  @@index([repoId, mergeCommitSha])
  @@map("ticket_git_refs")
}

/// One attempt by a model to fix a ticket in a linked repository.
///
/// The model never touches the repository directly. It reads and edits a
/// staged copy through a handful of tools; when it finishes, TaskForge commits
/// the staged changes to a fresh branch and opens a pull request. Merging is
/// always a person's decision.
model AiFixRun {
  id       String     @id @default(cuid())
  ticketId String
  ticket   Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  /// "anthropic", "openai" or "groq", and the exact model that ran.
  provider     String
  model        String
  /// Extra guidance typed by whoever started the run. Untrusted, like the ticket.
  instructions String?

  mode AiFixMode @default(FIX)

  /// HEAL_CI: the pull request whose branch is being fixed.

  targetPrNumber Int?

  /// A FIX built from an approved PLAN points at that plan.

  planRunId String?

  /// Runs started together for one ticket across several repositories share

  /// a batch, so their pull requests can point at each other.

  batchId String?

  status       AiFixStatus @default(QUEUED)
  branch       String?
  prNumber     Int?
  prUrl        String?
  /// The model's own account of what it changed, used as the PR description.
  summary      String?
  error        String?
  /// Paths the run changed, newline-separated. Display only.
  changedFiles String?
  /// Step-by-step record of the tool calls, for "why did it do that?". Plain
  /// text rather than JSON: it is read by people, never queried.
  transcript   String?
  turns        Int         @default(0)
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ticketId, createdAt])
  @@index([status])
  @@index([batchId])
  @@map("ai_fix_runs")
}

// =============================================================================
// AI ENGINES, USAGE AND BUDGETS
// =============================================================================

/// How the workspace uses one AI provider: which model, and optionally its own
/// key. Keyed by provider ("anthropic", "openai", "groq"). A key stored here is
/// sealed like the GitHub App's and takes precedence over the environment, so
/// an administrator can connect a provider without a redeploy.
model AiEngineSetting {
  provider    String   @id
  model       String
  apiKeyEnc   String?
  /// Last four characters of the stored key, so the page can say which key it is.
  keyHint     String?
  /// How this workspace pays for the provider: "free" (a free tier — nothing is
  /// billed, though the list-price cost is still recorded as an estimate),
  /// "list" (pay as you go at list price) or "custom" (the price set by hand
  /// on the model: a negotiated rate or a subscription's effective rate).
  billingPlan String   @default("list")
  /// The custom engine's OpenAI-compatible endpoint. Catalogue engines carry
  /// their own, so this is null for them.
  baseUrl     String?
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("ai_engine_settings")
}

/// Workspace-wide AI choices that are not per provider.
model AiWorkspaceSetting {
  id              Int     @id @default(1)
  /// The engine the Copilot, capture, filters and weekly update use. Null means
  /// the environment's AI_PROVIDER.
  copilotProvider String?
  /// The engine "Fix with AI" offers first. Null means the most capable available.
  fixProvider     String?

  updatedAt DateTime @updatedAt

  @@map("ai_workspace_settings")
}

/// Price per million tokens, used to turn token counts into money. Editable,
/// because list prices change and a company may have negotiated its own.
model AiModelPrice {
  provider            String
  model               String
  inputPerMTok        Decimal  @db.Decimal(10, 4)
  outputPerMTok       Decimal  @db.Decimal(10, 4)
  /// Where the list price came from: "auto" is the public catalogue (refreshed
  /// weekly); "manual" means the catalogue has no entry and a person typed it.
  source              String   @default("manual")
  /// What this workspace actually pays, when it differs from the list price —
  /// a negotiated rate, or a subscription's effective rate. Null means the list
  /// price applies. Used by engines on the "custom" billing plan.
  customInputPerMTok  Decimal? @db.Decimal(10, 4)
  customOutputPerMTok Decimal? @db.Decimal(10, 4)
  /// What the model can do, as the public catalogue records it. Null when the
  /// catalogue does not say — unknown, not false.
  supportsTools       Boolean?
  supportsReasoning   Boolean?
  supportsVision      Boolean?
  /// Largest input it accepts, in tokens.
  contextTokens       Int?

  updatedAt DateTime @updatedAt

  @@id([provider, model])
  @@map("ai_model_prices")
}

/// One model call. The ledger every usage report and budget is computed from.
model AiUsageEvent {
  id       String    @id @default(cuid())
  provider String
  model    String
  feature  AiFeature

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Set for AI fixes; not a relation, so deleting a ticket keeps its spend.
  ticketKey String?

  inputTokens    Int
  outputTokens   Int
  /// Cost at the time of the call, in millionths of a US dollar. Snapshotted, so
  /// editing a price later does not rewrite what last month cost.
  costMicros     BigInt @default(0)
  /// The same call at list price, whatever the plan — what it would have cost
  /// without a free tier or a discount. The basis for "what if" estimates.
  listCostMicros BigInt @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@map("ai_usage_events")
}

/// A monthly spending limit. Warns at 80% and 100%; blocks new runs only if
/// `hardStop` is set.
model AiBudget {
  id        String        @id @default(cuid())
  scope     AiBudgetScope
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider  String?

  monthlyLimitUsd Decimal @db.Decimal(10, 2)
  hardStop        Boolean @default(false)

  /// "2026-09:80" — the highest alert already sent this month, so each
  /// threshold is announced once rather than on every call past it.
  lastAlert String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, projectId, provider])
  @@map("ai_budgets")
}

/// Who receives which report: a person, or everyone in a team.
model ReportSubscription {
  id     String     @id @default(cuid())
  kind   ReportKind
  userId String?
  user   User?      @relation("ReportSubscriber", fields: [userId], references: [id], onDelete: Cascade)
  teamId String?
  team   Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?    @relation("ReportSubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([kind, userId])
  @@unique([kind, teamId])
  @@map("report_subscriptions")
}

/// A deployment of a linked repository, as reported to GitHub by whatever
/// deploys it — Vercel, Netlify, Render, a workflow. Read from GitHub's own
/// Deployments API, so no provider token is needed to know what shipped where.
model Deployment {
  id       String     @id @default(cuid())
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  githubId BigInt     @unique

  /// As the provider names it: "Production", "Preview", "staging".
  environment  String
  isProduction Boolean         @default(false)
  state        DeploymentState @default(PENDING)
  /// Where the deployment can be opened — the preview link a client clicks.
  url          String?
  /// Where its build log lives.
  logUrl       String?
  sha          String
  ref          String
  creatorLogin String?
  description  String?

  tickets TicketDeployment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repoId, sha])
  @@index([repoId, isProduction, state, createdAt])
  @@map("deployments")
}

/// Which tickets a deployment shipped.
model TicketDeployment {
  ticketId     String
  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([ticketId, deploymentId])
  @@index([deploymentId])
  @@map("ticket_deployments")
}

/// One distinct production error, however many times it has happened.
///
/// Grouped by fingerprint — the error's type and message with volatile parts
/// (numbers, ids, quoted values) masked, plus its top stack frame — so a
/// thousand occurrences of one bug are one ticket with a count, not a thousand
/// tickets.
model ErrorGroup {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint String

  title       String
  /// The latest occurrence's stack and context, for the ticket and the Coder.
  lastDetail  String   @db.Text
  environment String?
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([projectId, fingerprint])
  @@index([ticketId])
  @@map("error_groups")
}

/// An uptime check on a URL a project depends on.
///
/// Checked every few minutes by a scheduler outside Vercel (a GitHub Actions
/// workflow), because Vercel's own cron runs daily on the hobby plan. After
/// `failureThreshold` failures in a row it opens an incident ticket; on
/// recovery it says how long the outage lasted.
model Monitor {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name             String
  url              String
  expectedStatus   Int     @default(200)
  /// Text the response body must contain, to catch a page that answers 200
  /// while showing an error.
  keyword          String?
  intervalMinutes  Int     @default(5)
  failureThreshold Int     @default(2)
  isActive         Boolean @default(true)

  state               MonitorState @default(UNKNOWN)
  lastCheckedAt       DateTime?
  lastLatencyMs       Int?
  lastError           String?
  consecutiveFailures Int          @default(0)
  /// When the current outage began, while one is in progress.
  downSince           DateTime?
  incidentTicketId    String?

  checks MonitorCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isActive, lastCheckedAt])
  @@map("monitors")
}

/// One check. Kept for a week — enough for uptime percentages and an incident
/// timeline, not an ever-growing log.
model MonitorCheck {
  id        String   @id @default(cuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  ok        Boolean
  status    Int?
  latencyMs Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([monitorId, checkedAt])
  @@map("monitor_checks")
}

/// A credential for an integration that has no row of its own — a Vercel API
/// token, for instance. Sealed like the GitHub App's key; only the last four
/// characters are kept in the clear, so the page can say which token it is.
model IntegrationSecret {
  key       String   @id
  valueEnc  String
  hint      String
  /// Non-secret settings that travel with it, such as a Vercel team id.
  meta      String?
  updatedAt DateTime @updatedAt

  @@map("integration_secrets")
}

/// A person's own GitHub authorisation through the TaskForge app.
///
/// Needed for the one thing an app cannot do alone: create a repository under
/// a personal account. The token acts as that person, limited to what the app
/// is allowed, so a repository it creates is theirs. Sealed like every other
/// credential, and refreshed with the refresh token before it expires.
model GithubUserToken {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubLogin      String
  tokenEnc         String
  refreshEnc       String?
  expiresAt        DateTime?
  refreshExpiresAt DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("github_user_tokens")
}

/// Which engine and model one agent uses. An agent with no row, or whose
/// engine is not usable, falls back to the workspace default.
model AgentSetting {
  /// "copilot", "coder", "planner", "reviewer", "release" or "ops".
  agent     String   @id
  engineId  String
  model     String
  updatedAt DateTime @updatedAt

  @@map("agent_settings")
}
