# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# MCP — the committed .mcp.json uses ${VAR} expansion and holds no secret.
# Any local override must never be committed.
.mcp.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma
prisma/dev.db
prisma/dev.db-journal

# editor
.idea/
.vscode/*
!.vscode/extensions.json
.env*
