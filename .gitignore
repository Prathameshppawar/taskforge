# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# MCP — .mcp.json.example is the template; a real .mcp.json is per-machine and
# may reference secrets, so it is never committed.
.mcp.json
.mcp.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma
prisma/dev.db
prisma/dev.db-journal

# editor
.idea/
.vscode/*
!.vscode/extensions.json
.env*

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
